{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "island",
  "description": "The island: reports its hit area and placement, reads settings and stats",
  "windows": ["island"],
  "permissions": [
    "core:default",
    "store:default",
    "allow-set-hit-rect",
    "allow-island-anchor",
    "allow-drag-island",
    "allow-apply-config",
    "allow-set-quiet",
    "allow-set-island-open",
    "allow-open-settings",
    "allow-autostarted",
    "allow-pending-update",
    "allow-focus-island",
    "allow-release-island-focus",
    "allow-set-tray-tooltip"
  ]
}
