{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "The settings window: configuration, AI tool hooks, backups, updates, its own title bar and the links on About",
  "windows": ["settings"],
  "permissions": [
    "core:default",
    "store:default",
    "autostart:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/saif-o99" }, { "url": "https://github.com/saif-o99/ghars/issues" }]
    },
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "allow-apply-config",
    "allow-pause-island",
    "allow-island-paused",
    "allow-list-monitors",
    "allow-export-backup",
    "allow-import-backup",
    "allow-integrations-status",
    "allow-integration-install",
    "allow-integration-uninstall",
    "allow-install-skill",
    "allow-server-port",
    "allow-server-error",
    "allow-check-update",
    "allow-pending-update",
    "allow-install-update"
  ]
}
